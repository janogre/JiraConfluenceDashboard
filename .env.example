# Atlassian OAuth (valgfritt — kun nødvendig for OAuth-flyt)
# ATLASSIAN_CLIENT_ID=
# ATLASSIAN_CLIENT_SECRET=

# Atlassian API-nøkkel (valgfritt — brukes som fallback når session mangler.
# Slipper å logge inn på nytt etter logout eller server-restart.)
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=
JIRA_BASE_URL=https://<instans>.atlassian.net
CONFLUENCE_BASE_URL=https://<instans>.atlassian.net

# Anthropic (valgfritt — fallback for AI-endepunkter)
ANTHROPIC_API_KEY=

# Microsoft Business Central
BC_TENANT_ID=
BC_CLIENT_ID=
BC_CLIENT_SECRET=<secret-fra-Entra-ID>
BC_ENVIRONMENT=Production
BC_COMPANY_ID=
BC_ITEM_GROUPS=KOM,DRIFT

# Basis-URL til den frittstående AI Function App-en (Plan 2).
# Lokalt: http://localhost:7072 (func-porten under). Prod: https://<ai-app>.azurewebsites.net
VITE_AI_API_BASE=http://localhost:7072

# Function-key til AI Function App-en (x-functions-key). Tom lokalt (func håndhever ikke keys lokalt).
# Prod: hentes fra Function App-en. NB: havner i klient-bundelen — CORS-allowlist er den reelle beskyttelsen.
VITE_AI_FUNCTION_KEY=
